+/*
+ * SPDX-License-Identifier: GPL-3.0-only
+ * Scoria: audio file source node (MP3 / WAV / FLAC / OGG backing tracks)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 3 as
+ * published by the Free Software Foundation.
+ */
+#include "audiofilenode.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "../codecs/audiofiledecoder.h"
+#include "log.h"
+
+using namespace muse;
+using namespace muse::audio;
+using namespace muse::audio::engine;
+
+AudioFileNode::AudioFileNode(const ByteArray& fileData)
+{
+    if (!decode(fileData)) {
+        LOGE() << "Scoria: unsupported or corrupt audio file (" << fileData.size() << " bytes)";
+    }
+}
+
+bool AudioFileNode::decode(const ByteArray& d)
+{
+    DecodedAudio a = decodeAudioFile(d);
+    if (!a.isValid()) {
+        return false;
+    }
+    m_samples = std::move(a.samples);
+    m_frames = a.frames;
+    m_fileRate = a.sampleRate;
+    return true;
+}
+
+bool AudioFileNode::isValid() const
+{
+    return m_frames > 0 && m_fileRate > 0;
+}
+
+secs_t AudioFileNode::duration() const
+{
+    return m_fileRate > 0 ? secs_t(static_cast<double>(m_frames) / m_fileRate) : secs_t(0.0);
+}
+
+void AudioFileNode::seek(const TimePosition& position, const bool)
+{
+    m_positionSecs = position.time();
+}
+
+void AudioFileNode::flush()
+{
+}
+
+const AudioInputParams& AudioFileNode::inputParams() const
+{
+    return m_params;
+}
+
+void AudioFileNode::applyInputParams(const AudioInputParams& requiredParams)
+{
+    m_params = requiredParams;
+    m_paramsChanged.send(m_params);
+}
+
+async::Channel<AudioInputParams> AudioFileNode::inputParamsChanged() const
+{
+    return m_paramsChanged;
+}
+
+void AudioFileNode::prepareToPlay()
+{
+}
+
+bool AudioFileNode::readyToPlay() const
+{
+    return true; // everything is decoded up front
+}
+
+async::Notification AudioFileNode::readyToPlayChanged() const
+{
+    return m_readyChanged;
+}
+
+bool AudioFileNode::hasPendingChunks() const
+{
+    return false;
+}
+
+void AudioFileNode::processInput()
+{
+}
+
+InputProcessingProgress AudioFileNode::inputProcessingProgress() const
+{
+    return InputProcessingProgress();
+}
+
+void AudioFileNode::clearCache()
+{
+}
+
+void AudioFileNode::onModeChanged(const ProcessMode mode)
+{
+    m_mode = mode;
+}
+
+void AudioFileNode::onOutputSpecChanged(const OutputSpec&)
+{
+}
+
+void AudioFileNode::doSelfProcess(float* buffer, samples_t samplesPerChannel)
+{
+    const OutputSpec& spec = outputSpec();
+    const audioch_t outCh = spec.audioChannelCount;
+    if (!buffer || outCh == 0 || spec.sampleRate == 0) {
+        return;
+    }
+
+    const bool playing = m_mode == ProcessMode::Playing || m_mode == ProcessMode::PlayingOffline;
+    if (!playing || !isValid()) {
+        std::fill(buffer, buffer + samplesPerChannel * outCh, 0.0f);
+        return;
+    }
+
+    const double step = static_cast<double>(m_fileRate) / spec.sampleRate;
+    double src = m_positionSecs * m_fileRate;
+
+    for (samples_t i = 0; i < samplesPerChannel; ++i, src += step) {
+        float l = 0.0f;
+        float r = 0.0f;
+        if (src >= 0.0) {
+            const uint64_t i0 = static_cast<uint64_t>(src);
+            if (i0 + 1 < m_frames) {
+                const float t = static_cast<float>(src - static_cast<double>(i0));
+                const float* a = &m_samples[i0 * 2];
+                l = a[0] + (a[2] - a[0]) * t;
+                r = a[1] + (a[3] - a[1]) * t;
+            } else if (i0 < m_frames) {
+                l = m_samples[i0 * 2];
+                r = m_samples[i0 * 2 + 1];
+            }
+        }
+        float* out = buffer + i * outCh;
+        out[0] = l;
+        if (outCh > 1) {
+            out[1] = r;
+        }
+        for (audioch_t c = 2; c < outCh; ++c) {
+            out[c] = 0.0f;
+        }
+    }
+
+    m_positionSecs += static_cast<double>(samplesPerChannel) / spec.sampleRate;
+}
