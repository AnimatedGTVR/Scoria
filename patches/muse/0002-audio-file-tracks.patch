@@ -0,0 +1,67 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-only
+ * Scoria: audio file source node (MP3 / WAV / FLAC / OGG backing tracks)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 3 as
+ * published by the Free Software Foundation.
+ */
+#pragma once
+
+#include <vector>
+
+#include "audiosourcenode.h"
+#include "global/types/bytearray.h"
+#include "audio/common/audiotypes.h"
+
+namespace muse::audio::engine {
+//! Plays a decoded audio file in sync with the playhead.
+//! The whole file is decoded once (to float, stereo) when the node is created;
+//! playback just reads from that buffer at the current position, resampling linearly
+//! to the output sample rate.
+class AudioFileNode : public AudioSourceNode
+{
+public:
+    explicit AudioFileNode(const ByteArray& fileData);
+
+    //! Decoding succeeded and there is something to play
+    bool isValid() const;
+    secs_t duration() const;
+
+    void seek(const TimePosition& position, const bool flushSound = true) override;
+    void flush() override;
+
+    const AudioInputParams& inputParams() const override;
+    void applyInputParams(const AudioInputParams& requiredParams) override;
+    async::Channel<AudioInputParams> inputParamsChanged() const override;
+
+    void prepareToPlay() override;
+    bool readyToPlay() const override;
+    async::Notification readyToPlayChanged() const override;
+
+    bool hasPendingChunks() const override;
+    void processInput() override;
+    InputProcessingProgress inputProcessingProgress() const override;
+    void clearCache() override;
+
+private:
+    void onModeChanged(const ProcessMode mode) override;
+    void onOutputSpecChanged(const OutputSpec& spec) override;
+    void doSelfProcess(float* buffer, samples_t samplesPerChannel) override;
+
+    bool decode(const ByteArray& data);
+
+    std::vector<float> m_samples;      // interleaved stereo
+    uint64_t m_frames = 0;             // samples per channel
+    sample_rate_t m_fileRate = 0;
+
+    double m_positionSecs = 0.0;       // playhead position this node will render next
+    ProcessMode m_mode = ProcessMode::Undefined;
+
+    AudioInputParams m_params;
+    async::Channel<AudioInputParams> m_paramsChanged;
+    async::Notification m_readyChanged;
+};
+
+using AudioFileNodePtr = std::shared_ptr<AudioFileNode>;
+}
diff --git a/framework/audio/engine/internal/synthesizers/audiofilesynth/audiofilesynth.cpp b/framework/audio/engine/internal/synthesizers/audiofilesynth/audiofilesynth.cpp
new file mode 100644
index 00000000..ab03168a
--- /dev/null
+++ b/framework/audio/engine/internal/synthesizers/audiofilesynth/audiofilesynth.cpp
@@ -0,0 +1,240 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-only
+ * Scoria: "Audio Track" instrument sound
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 3 as
+ * published by the Free Software Foundation.
+ */
+#include "audiofilesynth.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+#include "global/io/file.h"
+#include "mpe/automationpoint.h"
+#include "log.h"
+
+using namespace muse;
+using namespace muse::audio;
+using namespace muse::audio::synth;
+
+namespace {
+constexpr double FADE_SECS = 0.008; // short fade at note edges so starts/stops don't click
+
+float levelToGain(mpe::dynamic_level_t level)
+{
+    // mf ("natural") plays the file at its own volume; every step of dynamics is ~3.5 dB
+    static const float natural = static_cast<float>(mpe::dynamicLevelFromType(mpe::DynamicType::Natural));
+    static const float step = static_cast<float>(mpe::DYNAMIC_LEVEL_STEP);
+    const float steps = (static_cast<float>(level) - natural) / step;
+    return std::clamp(std::pow(10.0f, steps * 3.5f / 20.0f), 0.0f, 4.0f);
+}
+}
+
+bool AudioFileSynth::isAudioFileResource(const AudioInputParams& params)
+{
+    return params.resourceMeta.id.rfind(RESOURCE_PREFIX, 0) == 0;
+}
+
+AudioFileSynth::AudioFileSynth(const AudioInputParams& params)
+    : AbstractSynthesizer(params)
+{
+    const std::string path = params.resourceMeta.id.substr(std::strlen(RESOURCE_PREFIX));
+
+    ByteArray data;
+    if (io::File::readFile(io::path_t(path), data) && !data.empty()) {
+        m_audio = engine::decodeAudioFile(data);
+    }
+
+    if (!m_audio.isValid()) {
+        LOGE() << "Scoria: can't load audio for Audio Track instrument: " << path;
+    }
+
+    m_timeline = std::make_shared<Timeline>();
+}
+
+std::string AudioFileSynth::name() const
+{
+    return "Scoria Audio File";
+}
+
+AudioSourceType AudioFileSynth::type() const
+{
+    return AudioSourceType::Fluid; // reuses the soundfont source type so no enum/serialization changes are needed
+}
+
+bool AudioFileSynth::isValid() const
+{
+    return m_audio.isValid();
+}
+
+void AudioFileSynth::setOutputSpec(const OutputSpec& spec)
+{
+    m_outputSpec = spec;
+}
+
+void AudioFileSynth::setupSound(const mpe::PlaybackSetupData& setupData)
+{
+    m_setupData = setupData;
+}
+
+void AudioFileSynth::setupEvents(const mpe::PlaybackData& playbackData)
+{
+    m_playbackData = playbackData;
+    rebuildTimeline(playbackData.originEvents, playbackData.dynamics);
+
+    // Score edits arrive here: rests, notes and dynamics update live
+    m_playbackData.mainStream.onReceive(this, [this](const mpe::PlaybackEventsMap& events,
+                                                     const mpe::DynamicAutomationLayers& dynamics) {
+        m_playbackData.originEvents = events;
+        m_playbackData.dynamics = dynamics;
+        rebuildTimeline(events, dynamics);
+    });
+}
+
+const mpe::PlaybackData& AudioFileSynth::playbackData() const
+{
+    return m_playbackData;
+}
+
+void AudioFileSynth::rebuildTimeline(const mpe::PlaybackEventsMap& events, const mpe::DynamicAutomationLayers& dynamics)
+{
+    auto tl = std::make_shared<Timeline>();
+    tl->dynamics = dynamics;
+
+    for (const auto& [timestamp, list] : events) {
+        for (const mpe::PlaybackEvent& ev : list) {
+            const mpe::NoteEvent* note = std::get_if<mpe::NoteEvent>(&ev);
+            if (!note) {
+                continue; // rests and everything else mean "silent"
+            }
+            const mpe::ArrangementContext& ac = note->arrangementCtx();
+            Gate g;
+            g.startUs = ac.actualTimestamp.raw();
+            g.endUs = g.startUs + ac.actualDuration.raw();
+            g.noteLevel = levelToGain(note->expressionCtx().nominalDynamicLevel);
+            if (g.endUs > g.startUs) {
+                tl->gates.push_back(g);
+            }
+        }
+    }
+
+    std::sort(tl->gates.begin(), tl->gates.end(), [](const Gate& a, const Gate& b) { return a.startUs < b.startUs; });
+
+    std::lock_guard lock(m_timelineMutex);
+    m_timeline = tl;
+}
+
+float AudioFileSynth::targetGainAt(const Timeline& tl, int64_t posUs) const
+{
+    // Is a note sounding here? (gates are sorted by start; notes can overlap)
+    auto it = std::upper_bound(tl.gates.begin(), tl.gates.end(), posUs, [](int64_t p, const Gate& g) { return p < g.startUs; });
+    const Gate* active = nullptr;
+    while (it != tl.gates.begin()) {
+        --it;
+        if (posUs < it->endUs) {
+            active = &*it;
+            break;
+        }
+        if (posUs - it->startUs > 600LL * 1000000LL) {
+            break; // nothing sane lasts 10 minutes, stop scanning back
+        }
+    }
+    if (!active) {
+        return 0.0f;
+    }
+
+    // Continuous dynamics (handles hairpins); fall back to the note's own dynamic
+    float best = -1.0f;
+    for (const auto& [layer, curve] : tl.dynamics) {
+        if (curve.empty()) {
+            continue;
+        }
+        const auto level = mpe::dynamicLevelFromNormalized(mpe::evaluateCurveAt(curve, mpe::timestamp_t(posUs)));
+        best = std::max(best, levelToGain(level));
+    }
+    return best >= 0.0f ? best : active->noteLevel;
+}
+
+TimePosition AudioFileSynth::playbackPosition() const
+{
+    return TimePosition::fromTime(secs_t(m_positionSecs), m_outputSpec.sampleRate);
+}
+
+void AudioFileSynth::setPlaybackPosition(const TimePosition& position)
+{
+    m_positionSecs = position.time();
+}
+
+void AudioFileSynth::flushSound()
+{
+    m_currentGain = 0.0f;
+}
+
+samples_t AudioFileSynth::process(float* buffer, samples_t samplesPerChannel)
+{
+    const audioch_t outCh = m_outputSpec.audioChannelCount;
+    if (!buffer || outCh == 0 || m_outputSpec.sampleRate == 0) {
+        return 0;
+    }
+
+    const bool playing = m_mode == ProcessMode::Playing || m_mode == ProcessMode::PlayingOffline;
+    if (!playing || !m_audio.isValid()) {
+        std::fill(buffer, buffer + samplesPerChannel * outCh, 0.0f);
+        return samplesPerChannel;
+    }
+
+    std::shared_ptr<const Timeline> tl;
+    {
+        std::lock_guard lock(m_timelineMutex);
+        tl = m_timeline;
+    }
+
+    const double outRate = m_outputSpec.sampleRate;
+    const double step = static_cast<double>(m_audio.sampleRate) / outRate;
+    const float fadeStep = static_cast<float>(1.0 / (FADE_SECS * outRate));
+    const std::vector<float>& s = m_audio.samples;
+    const uint64_t frames = m_audio.frames;
+
+    // The gate/dynamics target is evaluated every 64 samples (~1.5 ms); the gain ramps toward it
+    float target = 0.0f;
+    double src = m_positionSecs * m_audio.sampleRate;
+
+    for (samples_t i = 0; i < samplesPerChannel; ++i, src += step) {
+        if ((i & 63) == 0) {
+            const double t = m_positionSecs + static_cast<double>(i) / outRate;
+            target = targetGainAt(*tl, static_cast<int64_t>(t * 1000000.0));
+        }
+        if (m_currentGain < target) {
+            m_currentGain = std::min(target, m_currentGain + fadeStep * std::max(target, 1.0f));
+        } else if (m_currentGain > target) {
+            m_currentGain = std::max(target, m_currentGain - fadeStep * std::max(m_currentGain, 1.0f));
+        }
+
+        float l = 0.0f;
+        float r = 0.0f;
+        if (m_currentGain > 0.0f && src >= 0.0) {
+            const uint64_t i0 = static_cast<uint64_t>(src);
+            if (i0 + 1 < frames) {
+                const float frac = static_cast<float>(src - static_cast<double>(i0));
+                const float* a = &s[i0 * 2];
+                l = (a[0] + (a[2] - a[0]) * frac) * m_currentGain;
+                r = (a[1] + (a[3] - a[1]) * frac) * m_currentGain;
+            }
+        }
+
+        float* out = buffer + i * outCh;
+        out[0] = l;
+        if (outCh > 1) {
+            out[1] = r;
+        }
+        for (audioch_t c = 2; c < outCh; ++c) {
+            out[c] = 0.0f;
+        }
+    }
+
+    m_positionSecs += static_cast<double>(samplesPerChannel) / outRate;
+    return samplesPerChannel;
+}
diff --git a/framework/audio/engine/internal/synthesizers/audiofilesynth/audiofilesynth.h b/framework/audio/engine/internal/synthesizers/audiofilesynth/audiofilesynth.h
