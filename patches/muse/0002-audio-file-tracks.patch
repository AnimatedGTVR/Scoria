diff --git a/framework/audio/engine/internal/codecs/audiofiledecoder.cpp b/framework/audio/engine/internal/codecs/audiofiledecoder.cpp
new file mode 100644
index 00000000..0d121382
--- /dev/null
+++ b/framework/audio/engine/internal/codecs/audiofiledecoder.cpp
@@ -0,0 +1,103 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-only
+ * Scoria: decode MP3 / WAV / FLAC files to interleaved stereo float
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 3 as
+ * published by the Free Software Foundation.
+ */
+#include "audiofiledecoder.h"
+
+#include <cstring>
+
+#define DR_WAV_IMPLEMENTATION
+#define DR_MP3_IMPLEMENTATION
+#define DR_FLAC_IMPLEMENTATION
+#define DR_WAV_NO_STDIO
+#define DR_MP3_NO_STDIO
+#define DR_FLAC_NO_STDIO
+#include "audio/thirdparty/dr_libs/dr_wav.h"
+#include "audio/thirdparty/dr_libs/dr_mp3.h"
+#include "audio/thirdparty/dr_libs/dr_flac.h"
+
+#include "log.h"
+
+using namespace muse;
+using namespace muse::audio::engine;
+
+namespace {
+//! Keep the first two channels; duplicate mono to both sides.
+void appendAsStereo(std::vector<float>& out, const float* in, uint64_t frames, unsigned channels)
+{
+    out.reserve(out.size() + frames * 2);
+    for (uint64_t f = 0; f < frames; ++f) {
+        const float l = in[f * channels];
+        const float r = channels > 1 ? in[f * channels + 1] : l;
+        out.push_back(l);
+        out.push_back(r);
+    }
+}
+
+bool startsWith(const ByteArray& d, const char* magic, size_t offset = 0)
+{
+    const size_t n = std::strlen(magic);
+    return d.size() >= offset + n && std::memcmp(d.constData() + offset, magic, n) == 0;
+}
+}
+
+DecodedAudio muse::audio::engine::decodeAudioFile(const ByteArray& d)
+{
+    DecodedAudio out;
+    std::vector<float>& m_samples = out.samples;
+
+    const void* data = d.constData();
+    const size_t size = d.size();
+    if (!data || size == 0) {
+        return out;
+    }
+
+    unsigned int channels = 0;
+    unsigned int rate = 0;
+    drwav_uint64 frames = 0;
+    float* pcm = nullptr;
+
+    if (startsWith(d, "RIFF") || startsWith(d, "RF64") || startsWith(d, "riff")) {
+        pcm = drwav_open_memory_and_read_pcm_frames_f32(data, size, &channels, &rate, &frames, nullptr);
+        if (pcm) {
+            appendAsStereo(m_samples, pcm, frames, channels);
+            drwav_free(pcm, nullptr);
+        }
+    } else if (startsWith(d, "fLaC")) {
+        drflac_uint64 n = 0;
+        float* f = drflac_open_memory_and_read_pcm_frames_f32(data, size, &channels, &rate, &n, nullptr);
+        if (f) {
+            frames = n;
+            appendAsStereo(m_samples, f, frames, channels);
+            drflac_free(f, nullptr);
+        }
+    } else {
+        // MP3 (ID3 tag or raw frame sync); dr_mp3 skips ID3 itself
+        drmp3_config cfg {};
+        drmp3_uint64 n = 0;
+        float* f = drmp3_open_memory_and_read_pcm_frames_f32(data, size, &cfg, &n, nullptr);
+        if (f) {
+            channels = cfg.channels;
+            rate = cfg.sampleRate;
+            frames = n;
+            appendAsStereo(m_samples, f, frames, channels);
+            drmp3_free(f, nullptr);
+        }
+    }
+
+    if (m_samples.empty() || rate == 0) {
+        m_samples.clear();
+        return out;
+    }
+
+    out.frames = m_samples.size() / 2;
+    out.sampleRate = rate;
+    LOGI() << "Scoria: decoded audio file, " << out.frames << " frames @ " << rate << " Hz, "
+           << channels << " ch, " << out.duration() << " s";
+    return out;
+}
+
