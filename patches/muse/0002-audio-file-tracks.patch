+++ b/framework/audio/engine/internal/synthesizers/audiofilesynth/audiofilesynth.h
@@ -0,0 +1,78 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-only
+ * Scoria: "Audio Track" instrument sound
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 3 as
+ * published by the Free Software Foundation.
+ */
+#pragma once
+
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "../abstractsynthesizer.h"
+#include "../../codecs/audiofiledecoder.h"
+
+namespace muse::audio::synth {
+//! Plays an audio file (MP3/WAV/FLAC) as the sound of an instrument.
+//! The score drives it like any synth, but notes don't set a pitch:
+//!  - while a note sounds, the file plays (at its own time position, it's never re-pitched or stretched)
+//!  - during rests it's silent
+//!  - dynamics (p, mf, f, hairpins...) set the loudness; mf is the file's own volume
+class AudioFileSynth : public AbstractSynthesizer
+{
+public:
+    //! Sound ids look like "scoria-audio:/path/to/song.mp3"
+    static constexpr const char* RESOURCE_PREFIX = "scoria-audio:";
+    static bool isAudioFileResource(const AudioInputParams& params);
+
+    AudioFileSynth(const AudioInputParams& params);
+
+    std::string name() const override;
+    AudioSourceType type() const override;
+    bool isValid() const override;
+
+    void setOutputSpec(const OutputSpec& spec) override;
+
+    const mpe::PlaybackData& playbackData() const override;
+
+    TimePosition playbackPosition() const override;
+    void setPlaybackPosition(const TimePosition& position) override;
+
+    void flushSound() override;
+
+    samples_t process(float* buffer, samples_t samplesPerChannel) override;
+
+protected:
+    void setupSound(const mpe::PlaybackSetupData& setupData) override;
+    void setupEvents(const mpe::PlaybackData& playbackData) override;
+
+private:
+    struct Gate {
+        int64_t startUs = 0;
+        int64_t endUs = 0;
+        float noteLevel = 1.0f; // from the note's own dynamic, used when there is no dynamics curve
+    };
+
+    struct Timeline {
+        std::vector<Gate> gates;               // sorted by start
+        mpe::DynamicAutomationLayers dynamics;
+    };
+
+    void rebuildTimeline(const mpe::PlaybackEventsMap& events, const mpe::DynamicAutomationLayers& dynamics);
+    float targetGainAt(const Timeline& tl, int64_t posUs) const;
+
+    engine::DecodedAudio m_audio;
+    OutputSpec m_outputSpec;
+    mpe::PlaybackData m_playbackData;
+
+    std::shared_ptr<const Timeline> m_timeline;
+    mutable std::mutex m_timelineMutex;
+
+    double m_positionSecs = 0.0;
+    float m_currentGain = 0.0f;
+};
+}
