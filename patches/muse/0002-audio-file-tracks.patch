@@ -0,0 +1,28 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-only
+ * Scoria: decode MP3 / WAV / FLAC files to interleaved stereo float
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 3 as
+ * published by the Free Software Foundation.
+ */
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "global/types/bytearray.h"
+
+namespace muse::audio::engine {
+struct DecodedAudio {
+    std::vector<float> samples; // interleaved stereo (mono is duplicated)
+    uint64_t frames = 0;        // samples per channel
+    unsigned int sampleRate = 0;
+
+    bool isValid() const { return frames > 0 && sampleRate > 0; }
+    double duration() const { return sampleRate > 0 ? static_cast<double>(frames) / sampleRate : 0.0; }
+};
+
+//! Detects the format from the file header (RIFF/WAVE, fLaC, otherwise MP3)
+DecodedAudio decodeAudioFile(const ByteArray& data);
+}
